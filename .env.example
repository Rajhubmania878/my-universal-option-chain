# Environment Configuration for Universal Options Market Dashboard
APP_ENV=development
PROJECT_NAME="Universal Options Market Dashboard"
API_V1_PREFIX="/api/v1"
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
TIMEZONE="Asia/Kolkata"

# Database (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=options_market_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=20

# Cache & Real-time State (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TIMEOUT_MS=2000

# Snapshot & Engine Configuration
SNAPSHOT_INTERVAL_SECONDS=5
MARKET_DATA_REFRESH_RATE_MS=1000

# Angel One SmartAPI Credentials (Stored only on server, NEVER in client or Google Sheets)
ANGEL_API_KEY="YOUR_ANGEL_ONE_SMARTAPI_KEY"
ANGEL_CLIENT_CODE="YOUR_CLIENT_CODE"
ANGEL_PASSWORD="YOUR_CLIENT_PIN_OR_PASSWORD"
ANGEL_TOTP_SECRET="YOUR_BASE32_TOTP_SECRET"

# Google Sheets Integration
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@project.iam.gserviceaccount.com"
GOOGLE_SHEET_ID="YOUR_SPREADSHEET_ID"

# AI Studio runtime vars
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

